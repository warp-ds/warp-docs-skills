{
  "name": "warp-docs-skills",
  "description": "WARP Design System documentation automation for Claude Code: document, audit and inventory components straight from Figma.",
  "version": "1.1.0",
  "keywords": ["warp", "design-system", "documentation", "figma", "vitepress"],
  "mcpServers": {
    "figma-design-system": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp/figma-design-system-mcp/index.js"],
      "env": {
        "FIGMA_ACCESS_TOKEN": "${FIGMA_ACCESS_TOKEN}",
        "FIGMA_FILE_KEY": "${FIGMA_FILE_KEY:-oHBCzDdJxHQ6fmFLYWUltf}"
      }
    }
  }
}
