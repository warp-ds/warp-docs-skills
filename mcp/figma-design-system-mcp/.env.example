# Figma Personal Access Token
# Get yours at: https://www.figma.com/settings (Account > Personal access tokens)
FIGMA_ACCESS_TOKEN=figd_your_token_here

# Figma File Key (from the URL)
# Example: https://www.figma.com/file/ABC123DEF456/Design-System
# The file key is: ABC123DEF456
FIGMA_FILE_KEY=your_file_key_here
